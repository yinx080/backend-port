# Copy the lines you need into .env (which is gitignored) and fill them in.
# Never commit the real values.

# --- Contact form delivery (Resend) ---
# API key from resend.com/api-keys. Sending access is enough.
RESEND_API_KEY=

# The inbox where inquiries should land.
INQUIRY_TO=

# The address inquiries are sent FROM.
# No custom domain yet? Leave this empty: it falls back to Resend's test
# sender, which only delivers to your own Resend account address.
# With a verified domain: inquiries@yourdomain.com
INQUIRY_FROM=

# --- Unused so far ---
MONGODB_URL=
DATABASE_NAME=
